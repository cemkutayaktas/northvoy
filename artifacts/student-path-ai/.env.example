# Copy to .env.local for local development.
# Both values are public by design: Vite inlines VITE_* vars into the client
# bundle. The database is protected by Supabase Row Level Security, not by
# keeping these secret. Production values are set in the Vercel dashboard.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>
