.vercel

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Never commit env files. VITE_* values are public (they ship in the client
# bundle) but env files are where secrets end up, so none of them are tracked.
# Production values live in Vercel > Settings > Environment Variables.
.env
.env.*
!.env.example
.env.production
.env.development
*.pem
*.key
secrets.json
service-account*.json

# ─── Build output & deps ──────────────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local
.cache/

# ─── System / editor ──────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/
.vscode/*
!.vscode/extensions.json
